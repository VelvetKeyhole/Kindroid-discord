# Kindroid API Configuration
KINDROID_INFER_URL=https://api.kindroid.ai/v1/discord-bot  
KINDROID_API_KEY=your_kindroid_api_key_here

# Bot Configurations
# Add as many numbered sets as needed (1, 2, 3, etc.) 
# Required for each bot:
# - SHARED_AI_CODE_N: The shared AI code for API calls
# - BOT_TOKEN_N: Discord bot token
# Optional for each bot:
# - ENABLE_FILTER_N: Enable NSFW filtering

# Bot 1 Configuration
SHARED_AI_CODE_1=your_shared_code_1_here
BOT_TOKEN_1=your_discord_bot_token_1_here
ENABLE_FILTER_1=false  # Optional: Enable NSFW filtering.

# Bot 2 Configuration, add more by incrementing the _number
# SHARED_AI_CODE_2=your_shared_code_2_here
# BOT_TOKEN_2=your_discord_bot_token_2_here
# ENABLE_FILTER_2=false

# Optional persistent memory (server channels only; off by default).
MEMORY_ENABLED=false
DATABASE_URL=postgresql://user:password@host:5432/database
# Permanent character identities. Keep each with its corresponding bot when renumbering.
KIN_ID_1=maya-villa
# KIN_ID_2=theo-villa
# Only these Discord user IDs can add/list/show/edit/delete memories.
MEMORY_ADMIN_USER_IDS=123456789012345678
# One storyline per kin/channel. Use exact channel or thread IDs; no parent inheritance.
MEMORY_CONTEXTS='[{"kinId":"maya-villa","storyline":"villa-season-1","guildId":"123456789012345678","channelId":"234567890123456789"}]'

